# Copy these into Coolify -> Environment Variables. Do NOT commit real values.

# --- required ---
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-a-long-random-session-secret

# --- optional (defaults shown) ---
POSTGRES_DB=learningai
POSTGRES_USER=learningai
ALLOWED_ORIGINS=https://learningai4you.com,https://www.learningai4you.com

# Comma-separated emails that should be admins of the Backend Console.
# Anyone in this list is auto-granted admin on signup/login — no SQL needed.
# Add or remove admins by editing this value and redeploying.
ADMIN_EMAILS=aarav@shah.so
